rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/habits/{habitId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title', 'notes', 'category', 'schedule', 'priority', 'dueDate', 'createdDate', 'completions', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 240
        && request.resource.data.category in ['Personal', 'Work', 'Health', 'Home']
        && request.resource.data.schedule in ['daily', 'weekdays', 'weekends', 'once']
        && request.resource.data.priority in ['low', 'medium', 'high']
        && (request.resource.data.dueDate == null || request.resource.data.dueDate is string)
        && request.resource.data.createdDate is string
        && request.resource.data.completions is list;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title', 'notes', 'category', 'schedule', 'priority', 'dueDate', 'createdDate', 'completions', 'createdAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'notes', 'category', 'schedule', 'priority', 'dueDate', 'completions'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && (!request.resource.data.keys().hasAll(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 240))
        && (!request.resource.data.keys().hasAll(['category']) || request.resource.data.category in ['Personal', 'Work', 'Health', 'Home'])
        && (!request.resource.data.keys().hasAll(['schedule']) || request.resource.data.schedule in ['daily', 'weekdays', 'weekends', 'once'])
        && (!request.resource.data.keys().hasAll(['priority']) || request.resource.data.priority in ['low', 'medium', 'high'])
        && (!request.resource.data.keys().hasAll(['dueDate']) || request.resource.data.dueDate == null || request.resource.data.dueDate is string)
        && request.resource.data.completions is list;
    }
  }
}
